# Copia este archivo como .env y ajusta los valores.

# Puerto donde arranca la web
PUERTO=3000

# Ruta secreta del panel privado. Cámbiala por algo difícil de adivinar,
# por ejemplo /taller-snoker-8f3k. Solo letras, números, guiones y barras.
RUTA_PANEL=/panel

# Tamaño máximo de cada imagen subida, en MB
MAX_MB_SUBIDA=25

# Al publicar la web con HTTPS: pon NODE_ENV=production (activa cookies seguras)
# NODE_ENV=production

# Si la web va detrás de un proxy (Render, Railway, Nginx...), ponlo a 1
# CONFIAR_PROXY=1
