# Copia este archivo como .env para usar la web en tu PC.
# En Vercel, estas variables se ponen en Settings > Environment Variables.

# Contraseña del panel privado (mínimo 10 caracteres).
CLAVE_PANEL=

# Ruta secreta del panel. Cámbiala por algo difícil de adivinar,
# por ejemplo /taller-snoker-8f3k. Solo letras, números, guiones y barras.
RUTA_PANEL=/panel

# Puerto de la web en tu PC
PUERTO=3000

# Tamaño máximo de cada imagen en tu PC, en MB (en Vercel el máximo es 4,3 MB
# y el panel optimiza solo las imágenes más grandes antes de subirlas).
MAX_MB_SUBIDA=25

# Si pones aquí el token de Vercel Blob, tu PC usará el mismo almacén que la
# web publicada (lo que subas en local aparecerá en internet). Sin él, en tu PC
# se usan las carpetas datos/ y subidas/.
# BLOB_READ_WRITE_TOKEN=
